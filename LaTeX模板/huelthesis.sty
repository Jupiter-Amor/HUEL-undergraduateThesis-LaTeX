% 标题不用斜体，末尾不加句号/顿号；不要用enumerate列表充当章节标题。
% 一级：16bp宋体粗、TNR数字粗、居中、单倍基线约20.72bp，Word段前后12bp。
% TeX标题字框与正文基线的连接额外占约2bp，段后设置10bp作等效补偿。
% 一级标题连续排版，不用\chapter，不附加\clearpage或空白段落。
\newcommand{\ThesisFirstFont}{\normalfont\songti\bfseries\fontsize{16bp}{20.72bp}\selectfont}
\titleformat{\section}[block]{\ThesisFirstFont\centering}{\thesection}{.25em}{}
\titlespacing{\section}{0pt}{12bp}{10bp}
% 二级：12bp宋体粗、首行两字、单倍基线15.54bp、段前后6bp。
\titleformat{\subsection}[block]{\normalfont\songti\bfseries\fontsize{12bp}{15.54bp}\selectfont}{\thesubsection}{.5em}{}
\titlespacing{\subsection}{24bp}{6bp}{6bp}
% 三级：12bp宋体常规，序号2.1.1，无粗体/斜体、首行两字。
% 原doc的2.1.1样例为段前后2.4bp、1.5倍；2.2.1样例却为6bp、单倍。
% 默认保留前者；需要后一种原样式时仅调用\ThesisThirdCompactStyle。
\titleformat{\subsubsection}[block]{\normalfont\songti\fontsize{12bp}{23.31bp}\selectfont\ThesisNormalSpacing}{\thesubsubsection}{.5em}{}
\titlespacing{\subsubsection}{24bp}{2.4bp}{2.4bp}
\newcommand{\ThesisThirdCompactStyle}{%
  \titleformat{\subsubsection}[block]{\normalfont\songti\fontsize{12bp}{15.54bp}\selectfont\ThesisNormalSpacing}{\thesubsubsection}{.5em}{}
  \titlespacing{\subsubsection}{24bp}{6bp}{6bp}}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
% 两个TNR空格加Word自动中英间隔，16bp标题间空约16bp；目录随10bp字号缩放。
\newcommand{\ThesisTitleGap}{\hspace{1em}}
% 四级及以下：手写（1）（2），不用顿号；12bp常规，首行两字。
\newcommand{\ThesisItem}[2]{\par\noindent\hspace*{24bp}（#1）#2\par}

