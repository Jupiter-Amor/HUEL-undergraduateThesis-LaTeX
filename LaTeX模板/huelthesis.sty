% 图表直接在调用处插入，与Word嵌入正文相同；不采用LaTeX默认浮动。
% 每个图/表和标题/来源作为一个整体，不拆页，放不下则整体移至下一页。
% 图、表按一级章节重置：图2-1、表2-1；公式单独为(2.1)。
\counterwithin{figure}{section}
\counterwithin{table}{section}
\counterwithin{equation}{section}
\renewcommand{\thefigure}{\thesection-\arabic{figure}}
\renewcommand{\thetable}{\thesection-\arabic{table}}
\renewcommand{\theequation}{\thesection.\arabic{equation}}
% 图段落继承首行2字、居中→右移12bp；图题继承首行4字→右移24bp。
% 以下保留原版视觉偏移；给图的实际宽度预留偏移，避免超出页边距。
\newsavebox{\ThesisFigureBox}
\newsavebox{\ThesisTableBox}
\newenvironment{thesisfigure}[2]{%
  \par\noindent\begin{minipage}{\linewidth}\ThesisNormalSpacing
  \def\ThesisFigureTitle{#1}\def\ThesisFigureLabel{#2}%
  \begin{lrbox}{\ThesisFigureBox}%
}{%
  \end{lrbox}\noindent\makebox[\linewidth][c]{\hspace*{24bp}\usebox{\ThesisFigureBox}}\par
  \refstepcounter{figure}\label{\ThesisFigureLabel}%
  \noindent\hspace*{48bp}\begin{minipage}{\dimexpr\linewidth-48bp\relax}
    \normalfont\songti\bfseries\fontsize{12bp}{19.43bp}\selectfont\centering
    图\,\thefigure\hspace{24bp}\ThesisFigureTitle\par
  \end{minipage}\par
  \end{minipage}\par}
\newcommand{\ThesisFigureRef}[1]{图\,\ref{#1}}
\newcommand{\ThesisTableRef}[1]{表\,\ref{#1}}
% 表宽可自定；示例宽149.031mm。表号常规12bp，标题粗12bp，单位常规12bp。
% 表号以表左线为起点缩进两字，单位居右；来源五号仿宋且缩进两字。
\newenvironment{thesistable}[4][149.031mm]{%
  \par\begin{lrbox}{\ThesisTableBox}\begin{minipage}{#1}
  \ThesisNormalSpacing\refstepcounter{table}\label{#4}%
  \noindent\makebox[\linewidth][l]{\fontsize{12bp}{19.43bp}\selectfont
    \makebox[0pt][l]{\hspace{24bp}表\,\thetable}%
    \makebox[\linewidth][c]{\normalfont\songti\bfseries #2}%
    \makebox[0pt][r]{单位：#3\hspace{24bp}}}\par
  \ThesisSmallFont\centering
  \setlength{\tabcolsep}{5.4bp}\setlength{\arrayrulewidth}{.75bp}%
  \renewcommand{\arraystretch}{1.18}%
}{\par\end{minipage}\end{lrbox}\noindent\makebox[\linewidth][c]{\usebox{\ThesisTableBox}}\par}
\newcommand{\ThesisTableSource}[1]{%
  \par{\raggedright\noindent\normalfont\CJKfamily{thesisfang}\fontsize{10.5bp}{16.4bp}\selectfont
    \hspace*{21bp}资料来源：#1\par}}
% 原范例有内部竖线：顶/底1.5bp，行间横线/竖线0.75bp，左右不画外框。
