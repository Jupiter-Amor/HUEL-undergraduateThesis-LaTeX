% 字体必须与Word相同，禁止静默替换成思源宋体/Fandol/苹方。
% fonts.tex 可在加载本包前提供 \ThesisSongFont 等宏，值为字体名或文件完整路径。
% macOS Office 的字体常未注册给Fontconfig，故同时检查原版字体文件。
\newcommand{\ThesisResolveFont}[3]{%
  \ifdefined#1\else
    \IfFileExists{#3}{\def#1{#3}}{%
      \IfFontExistsTF{#2}{\def#1{#2}}{%
        \PackageError{huelthesis}{Required font #2 missing}{Set its exact font file in fonts.tex.}%
        \def#1{#2}}}%
  \fi}
\ThesisResolveFont{\ThesisSongFont}{SimSun}{/Applications/Microsoft Word.app/Contents/Resources/DFonts/SimSun.ttf}
\ThesisResolveFont{\ThesisHeiFont}{SimHei}{/Applications/Microsoft Word.app/Contents/Resources/DFonts/SimHei.ttf}
\ThesisResolveFont{\ThesisFangFont}{FangSong}{/Applications/Microsoft Word.app/Contents/Resources/DFonts/Fangsong.ttf}
\ThesisResolveFont{\ThesisDeclFont}{方正小标宋简体}{/Users/wang/Library/Fonts/方正小标宋简体.ttf}
\ThesisResolveFont{\ThesisLatinFont}{Times New Roman}{/System/Library/Fonts/Supplemental/Times New Roman.ttf}
\ThesisResolveFont{\ThesisLatinBoldFont}{Times New Roman/B}{/System/Library/Fonts/Supplemental/Times New Roman Bold.ttf}
\ThesisResolveFont{\ThesisLatinItalicFont}{Times New Roman/I}{/System/Library/Fonts/Supplemental/Times New Roman Italic.ttf}
\ThesisResolveFont{\ThesisLatinBoldItalicFont}{Times New Roman/BI}{/System/Library/Fonts/Supplemental/Times New Roman Bold Italic.ttf}
\ThesisResolveFont{\ThesisPageFont}{Arial}{/System/Library/Fonts/Supplemental/Arial.ttf}
% 宋体没有原生粗体。Word对宋体作合成加粗；此处采用XeTeX合成粗体。
% 英文粗体/斜体使用Times New Roman的真实字形。
\setmainfont[NFSSFamily=thesislatin,BoldFont=\ThesisLatinBoldFont,
  ItalicFont=\ThesisLatinItalicFont,BoldItalicFont=\ThesisLatinBoldItalicFont]{\ThesisLatinFont}
\setCJKmainfont[NFSSFamily=thesissong,AutoFakeBold=2.17]{\ThesisSongFont}
\setCJKsansfont[NFSSFamily=thesissans]{\ThesisHeiFont}
\setCJKfamilyfont{thesishei}[NFSSFamily=thesishei]{\ThesisHeiFont}
\setCJKfamilyfont{thesisfang}[NFSSFamily=thesisfang]{\ThesisFangFont}
\setCJKfamilyfont{thesisdecl}[NFSSFamily=thesisdecl]{\ThesisDeclFont}
\providecommand{\songti}{\CJKfamily{\CJKrmdefault}}
\newfontfamily\ThesisFooterFont[NFSSFamily=thesisfooter]{\ThesisPageFont}
\newfontfamily\ThesisSpacedLatin[NFSSFamily=thesisspaced,LetterSpace=-0.833333,
  BoldFont=\ThesisLatinBoldFont,ItalicFont=\ThesisLatinItalicFont,
  BoldItalicFont=\ThesisLatinBoldItalicFont]{\ThesisLatinFont}
% Normal 样式字间距-2 twips=-0.1bp。该设置局限正文，不影响目录/数学/参考文献。
\newcommand{\ThesisBodySpacing}{%
  \ThesisSpacedLatin
  \xeCJKsetup{CJKglue=\hskip -0.1bp plus .05bp minus .05bp,
    CJKecglue=\hskip .2em plus .1em minus .1em}}
\newcommand{\ThesisNormalSpacing}{%
  \rmfamily\xeCJKsetup{CJKglue=\hskip 0pt plus .05bp minus .05bp,
    CJKecglue=\hskip .2em plus .1em minus .1em}}

